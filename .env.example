# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_BROWSER_PORT=3001
FALKORDB_PASSWORD=
FALKORDB_GRAPH=trilhagraph_aprendizagem

# Embeddings. nomic-embed-text produz vetores com 768 dimensoes.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Modelo de chat local usado na extracao e na geracao de respostas.
CHAT_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=600

# Segmentacao dos documentos TXT (em caracteres).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
