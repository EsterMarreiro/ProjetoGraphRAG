# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_BROWSER_PORT=3001
FALKORDB_PASSWORD=
FALKORDB_GRAPH=trilhagraph_openai

# OpenAI: chave pessoal, nunca versionada. O modelo de embeddings aceita
# EMBEDDING_DIMENSION menor que o padrao; trocar a dimensao exige novo grafo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=120
CHAT_MODEL=gpt-4.1
EXTRACTION_MODEL=gpt-4o-mini
# VERIFIER_MODEL reutiliza CHAT_MODEL; defina vazio para desligar a verificação.
# VERIFIER_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=768

# Segmentacao dos documentos TXT (em caracteres).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
