# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
FALKORDB_PASSWORD=
FALKORDB_GRAPH=rotagraph_brasil

# Embeddings. nomic-embed-text produz vetores com 768 dimensoes.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Modelo de chat local usado na extracao e na geracao de respostas.
CHAT_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Segmentacao dos documentos TXT (em caracteres).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
